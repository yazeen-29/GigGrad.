DATABASE_URL=postgresql://giggrad:change-this-password@localhost:5432/giggrad
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=5000
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development

# Optional live AI. Keep these on the server; never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=

# Public campus signup stays closed until real email delivery is tested.
PUBLIC_SIGNUP_ENABLED=0
CAMPUS_EMAIL_DOMAINS=
APP_ORIGIN=http://localhost:5173
# HTTPS email delivery for Render Free (requires your verified sending domain).
RESEND_API_KEY=
MAIL_FROM=
# Alternative SMTP on hosts that allow these ports. Render Free blocks 25/465/587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
